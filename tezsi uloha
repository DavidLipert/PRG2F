using System;

class Coder
{
    private int secret; 

    public Coder(int secret)
    {
        this.secret = secret;
    }

    public int GetSecret()
    {
        return secret;
    }

    public string Encode(string input)
    {
        string result = "";

        foreach (char c in input)
        {
            if (char.IsLetter(c)) // pracujeme jen s písmeny
            {
                char baseChar = char.IsUpper(c) ? 'A' : 'a';
                char encoded = (char)(baseChar + (c - baseChar + secret) % 26);
                result += encoded;
            }
            else
            {
                // ostatní znaky (mezery, čísla apod.) necháme beze změny
                result += c;
            }
        }

        return result;
    }

    public string Decode(string input)
    {
        string result = "";

        foreach (char c in input)
        {
            if (char.IsLetter(c))
            {
                char baseChar = char.IsUpper(c) ? 'A' : 'a';
                // přičteme 26, aby výsledek nebyl záporný (kvůli modulu)
                char decoded = (char)(baseChar + (c - baseChar - secret + 26) % 26);
                result += decoded;
            }
            else
            {
                result += c;
            }
        }

        return result;
    }
}

class Program
{
    static void Main()
    {
        // vytvoření "kódovače" s tajemstvím = 3
        Coder coder = new Coder(3);

        string text = "ahoj";
        string zakodovano = coder.Encode(text);
        string dekodovano = coder.Decode(zakodovano);

        Console.WriteLine($"Tajné číslo: {coder.GetSecret()}");
        Console.WriteLine($"Původní text: {text}");
        Console.WriteLine($"Zakódováno: {zakodovano}");
        Console.WriteLine($"Dekódováno: {dekodovano}");
    }
}
